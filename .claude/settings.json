{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.production)",
      "Edit(**/.env.production)",
      "Read(**/.env.development)",
      "Edit(**/.env.development)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env_access.py\"",
            "statusMessage": "Comprobando acceso a .env"
          }
        ]
      }
    ]
  }
}
